{
  "name": "pdf-teleprompter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc -b && vite build",
    "build:single": "node scripts/build-single.mjs",
    "assets": "node scripts/copy-pdf-assets.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:e2e": "npm run build && node tests/e2e.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.32.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "Client-side PDF teleprompter for reading scripts aloud on camera."
}
